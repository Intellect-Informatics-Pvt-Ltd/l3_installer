<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />

    <add
      key="local-artifacts"
      value="artifacts/nuget" />

    <add
      key="github"
      value="https://nuget.pkg.github.com/Intellect-Informatics-Pvt-Ltd/index.json"
      protocolVersion="3" />

    <add
      key="nuget.org"
      value="https://api.nuget.org/v3/index.json"
      protocolVersion="3" />
  </packageSources>

  <!--
    GitHub Packages credentials are injected at workflow runtime by
    build_push_script.sh using GITHUB_PACKAGES_USERNAME and
    GITHUB_PACKAGES_PAT.

    Never commit PATs, passwords, or ClearTextPassword values here.
  -->

  <packageSourceMapping>
    <packageSource key="local-artifacts">
      <package pattern="Intellect.*" />
    </packageSource>

    <packageSource key="github">
      <package pattern="Intellect.*" />
    </packageSource>

    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

  <config>
    <add key="auditMode" value="all" />
    <add key="auditLevel" value="high" />
  </config>
</configuration>
