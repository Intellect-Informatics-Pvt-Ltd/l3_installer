<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\SharedKernel\SharedKernel.csproj" />
    <!-- Installer.Core owns the pipeline, so it must see the steps the pipeline drives.
         Acyclic: Installer.Actions and ManifestVerifier both depend only on SharedKernel. -->
    <ProjectReference Include="..\Installer.Actions\Installer.Actions.csproj" />
    <ProjectReference Include="..\ManifestVerifier\ManifestVerifier.csproj" />
    <!-- The upgrade engine's safety net IS the backup engine, and its rollback path IS the
         restore engine. Acyclic: BackupRestore depends only on SharedKernel and
         Installer.Actions, both of which Installer.Core already references. -->
    <ProjectReference Include="..\BackupRestore\BackupRestore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="MySqlConnector" />
    <!-- The composition root lives here (DependencyInjection/), so this project binds
         configuration and registers services rather than only consuming IOptions. -->
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

</Project>
