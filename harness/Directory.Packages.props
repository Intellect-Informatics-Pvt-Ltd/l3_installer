<Project>
  <!--
    Central Package Management — all NuGet versions pinned here.
    Internal Intellect.Erp.* packages must be resolved from the offline feed
    configured in NuGet.Config.  The version "1.0.0" below is a placeholder;
    update to the actual published version before the first build.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Required so the SSH.NET pin below actually takes effect: without transitive pinning,
         a PackageVersion for a package nothing references directly is simply ignored. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!-- ── Microsoft / .NET ──────────────────────────────────────── -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi"            Version="8.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Hosting"            Version="8.0.1" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="8.0.1" />
    <PackageVersion Include="Microsoft.Extensions.Http"               Version="8.0.1" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.3" />
    <PackageVersion Include="Microsoft.Extensions.Options"            Version="8.0.2" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="8.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder"      Version="8.0.2" />
    <PackageVersion Include="Microsoft.AspNetCore.Diagnostics.HealthChecks" Version="2.2.0" />
    <PackageVersion Include="AspNetCore.HealthChecks.MySql"                 Version="8.0.1" />
    <PackageVersion Include="AspNetCore.HealthChecks.Redis"                 Version="8.0.1" />
  </ItemGroup>

  <!-- ── Data / ORM ────────────────────────────────────────────── -->
  <ItemGroup>
    <PackageVersion Include="Dapper"                                  Version="2.1.35" />
    <PackageVersion Include="MySqlConnector"                          Version="2.3.7" />
    <PackageVersion Include="DbUp-MySql"                              Version="5.0.28" />
  </ItemGroup>

  <!-- ── Messaging / Kafka ─────────────────────────────────────── -->
  <ItemGroup>
    <PackageVersion Include="Confluent.Kafka"                         Version="2.5.0" />
  </ItemGroup>

  <!-- ── Caching ───────────────────────────────────────────────── -->
  <ItemGroup>
    <PackageVersion Include="StackExchange.Redis"                     Version="2.8.12" />
    <PackageVersion Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="8.0.14" />
  </ItemGroup>

  <!-- ── Resilience ────────────────────────────────────────────── -->
  <ItemGroup>
    <PackageVersion Include="Polly"                                   Version="8.4.1" />
    <PackageVersion Include="Polly.Extensions"                        Version="8.4.1" />
    <PackageVersion Include="Polly.RateLimiting"                      Version="8.4.1" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience"    Version="8.11.0" />
  </ItemGroup>

  <!-- ── Serialisation ─────────────────────────────────────────── -->
  <ItemGroup>
  </ItemGroup>

  <!-- ── Testing ───────────────────────────────────────────────── -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.NET.Test.Sdk"                  Version="17.10.0" />
    <PackageVersion Include="xunit"                                   Version="2.9.0" />
    <PackageVersion Include="xunit.runner.visualstudio"               Version="2.8.2" />
    <PackageVersion Include="FluentAssertions"                        Version="6.12.1" />
    <PackageVersion Include="Moq"                                     Version="4.20.70" />
    <PackageVersion Include="FsCheck.Xunit"                          Version="2.16.6" />
    <PackageVersion Include="Testcontainers"                          Version="3.9.0" />
    <PackageVersion Include="Testcontainers.Kafka"                    Version="3.9.0" />
    <PackageVersion Include="Testcontainers.MySql"                    Version="3.9.0" />
    <PackageVersion Include="Testcontainers.Redis"                    Version="3.9.0" />

    <!-- SECURITY PIN, not a preference. Testcontainers 3.9.0 pulls SSH.NET transitively, and
         every SSH.NET release up to and including 2025.1.0 carries GHSA-q939-rpr3-3284 (HIGH):
         ScpClient recursive download allows arbitrary file write via server-controlled SCP
         filenames. The advisory's first patched version is 2026.0.0, so that is the floor.

         NuGet.Config sets auditMode=all / auditLevel=high, so this surfaces as NU1903 and,
         with TreatWarningsAsErrors, fails the build - which is exactly the behaviour we want
         for a product delivered on removable media to sites with no patch channel.

         Pinned transitively rather than fixed by moving to Testcontainers 4.x, because
         Testcontainers.Kafka has no 4.x release in the estate's package mirror and an upgrade
         that cannot restore offline is not an upgrade for this product.

         ACTION FOR THE MIRROR: SSH.NET 2026.0.0 must be added to the offline feed. Unlike
         every other version in this file it is not yet cached, and a disconnected build host
         will fail to restore until it is. That is the correct failure - do not "fix" it by
         lowering this pin.

         DO NOT lower this version. If a Testcontainers upgrade later makes the pin redundant,
         remove it in the same commit and confirm `dotnet restore` reports no NU1903. -->
    <PackageVersion Include="SSH.NET"                                 Version="2026.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing"        Version="8.0.14" />
  </ItemGroup>
</Project>
