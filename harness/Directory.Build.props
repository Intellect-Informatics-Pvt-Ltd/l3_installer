<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Pinned deliberately, NOT `latest-recommended`. With `latest`, the analyser set is
         chosen by whichever SDK happens to be installed, so the same commit can build clean on
         one machine and fail on another; `TreatWarningsAsErrors` turns that difference into a
         broken build rather than a diff in warning counts. Tying the level to the
         TargetFramework means the analyser set moves when the code moves - as a decision, in a
         reviewable commit - and never as a side effect of the build agent. Raise this in the
         same commit that raises the TargetFramework, and clear the new diagnostics then. -->
    <AnalysisLevel>10.0-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <LangVersion>14.0</LangVersion>
  </PropertyGroup>

  <PropertyGroup>
    <Company>Intellect Design Arena Ltd.</Company>
    <Product>ePACS Sync Test Harness</Product>
    <Copyright>Copyright © Intellect Design Arena Ltd. 2024-2026</Copyright>
    <AssemblyVersion>1.0.0</AssemblyVersion>
    <FileVersion>1.0.0</FileVersion>
  </PropertyGroup>

  <!-- ═══════════════════════════════════════════════════════════════════════════
       Native Windows EXE publish profile (win-x64, self-contained, single-file).
       Activated by: dotnet publish -c Release
       Individual projects opt-in by being OutputType=Exe or Sdk.Web/Sdk.Worker.
       Library projects (Harness.Common, Harness.ScenarioPlayer) are excluded via
       the IsPublishable=false condition below.
       ═══════════════════════════════════════════════════════════════════════════ -->
  <!--
    PUBLISH PROFILE — framework-dependent. See ADR-0009, which supersedes ADR-0007 §1.

    ADR-0007 chose self-contained single-file, and it was right for the payload it was written
    against: four harness services. Measured on the real payload of 26 L2-R2 services, that
    costs 4.0 GB against 1.4 GB — 2.6 GB of the same .NET runtime, bundled twenty-six times,
    onto a medium carried by hand to a village. It also made delta upgrades impractical: every
    patch shipped a runtime whether or not it changed.

    Offline-first is unaffected. The runtime still arrives on the medium, as its own manifest
    payload verified by SHA-256 like MySQL or the JRE — it arrives once instead of per service.

    RuntimeIdentifier is deliberately NOT set here either. Under a blanket
    `Configuration == Release` it made every Release BUILD win-x64, including test projects,
    which inherit the RID through their ProjectReference to Harness.Common — so
    `dotnet test -c Release` aborted on any non-Windows host. A RID belongs to `dotnet publish`,
    not `dotnet build`; it is passed by publish-win-x64.ps1 and the CI publish job.
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <SelfContained>false</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>

    <!--
      Pin roll-forward to the band that was tested. The default would let a node silently run a
      newer runtime than anything this release was verified against — on a machine nobody
      administers and which nobody will visit again soon.
    -->
    <RollForward>LatestPatch</RollForward>
  </PropertyGroup>

  <!-- Libraries are not publishable as standalone EXEs -->
  <PropertyGroup Condition="'$(IsPackable)' == 'false'">
    <IsPublishable>false</IsPublishable>
  </PropertyGroup>

  <!-- Suppress IDE0005 (unused usings) warnings that fire in Razor projects -->
  <PropertyGroup Condition="'$(MSBuildProjectExtension)' == '.csproj' AND $(MSBuildProjectName.EndsWith('Ui'))">
    <NoWarn>IDE0005;$(NoWarn)</NoWarn>
  </PropertyGroup>
</Project>
